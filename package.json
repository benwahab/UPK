{
  "name": "upk",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "seed:sql": "node --experimental-strip-types infra/scripts/seed.ts",
    "e2e:prepare": "pnpm seed:sql > /tmp/upk-e2e-seed.sql && pnpm -C apps/web exec wrangler d1 migrations apply upk --local --config ../../infra/wrangler.toml --persist-to .wrangler/state -y && pnpm -C apps/web exec wrangler d1 execute upk --local --config ../../infra/wrangler.toml --persist-to .wrangler/state --file=/tmp/upk-e2e-seed.sql",
    "e2e": "playwright test",
    "backup:d1": "bash infra/scripts/backup-d1.sh"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@playwright/test": "1.55.0",
    "eslint": "^9.32.0",
    "eslint-config-prettier": "^10.1.1",
    "globals": "^15.15.0",
    "prettier": "^3.7.3",
    "turbo": "^2.11.13",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.56.1",
    "wrangler": "^4.166.0"
  }
}
